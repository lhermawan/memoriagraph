# MemoriaGraph 3.0 Environment Configuration Template
# Duplicate this file to .env and configure your environment.

# Neo4j Bolt Connection (Default: localhost:7687 or via Tailscale)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_this_secure_password

# Optional: Default Memory Bank ('infra-sre', 'ai-hud', 'research-personal', 'csirt-security', 'general')
DEFAULT_MEMORY_BANK=general

# Optional: Embedding ONNX Model (Default: BAAI/bge-small-en-v1.5)
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
