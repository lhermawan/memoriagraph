# MemoriaGraph 3.2 Environment Configuration Template
# Duplicate this file to .env and configure your environment.

# Neo4j Bolt Connection (Default: localhost:7687 or neo4j:7687 in Docker)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_this_secure_password

# Working Directory & Storage Paths (Defaults to repo root)
# MEMORIAGRAPH_HOME=.
# VECTOR_CACHE_FILE=.vector_cache.pkl
# EVENTS_DIR=events

# HTTP API Gateway & Cockpit (Port 8085)
MEMORIAGRAPH_HTTP_HOST=0.0.0.0
MEMORIAGRAPH_HTTP_PORT=8085

# Security Gateway Network Mode:
# - 'private'   : (Default) Permits localhost, Tailscale CGNAT, and RFC1918 private subnets (Docker 172.x, LAN 192.168.x, 10.x).
# - 'tailscale' : Strict mode, restricts access to Tailscale mesh (100.64.0.0/10) and loopback only.
# - 'all'       : Open access (recommended ONLY when deployed behind an authenticated reverse proxy).
SECURITY_NETWORK_MODE=private

# Optional: Default Memory Bank ('infra-sre', 'ai-hud', 'research-personal', 'csirt-security', 'general')
DEFAULT_MEMORY_BANK=general

# Optional: Embedding ONNX Model (Default: BAAI/bge-small-en-v1.5)
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
